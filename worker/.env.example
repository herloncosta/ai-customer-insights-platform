# Worker local (fora do Docker). No compose as vars vêm do service.
NODE_ENV=development
DATABASE_URL="mysql://insights_user:insightspass123@localhost:3306/insights_db"
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
FEEDBACK_QUEUE="feedback_processing_queue"
FEEDBACK_DLQ="feedback_processing_queue.dlq"
OPENAI_API_KEY=""
OPENAI_MODEL="openai/gpt-4o-mini"
# Gateway compatível com a API OpenAI (ex. OpenRouter). Vazio = api.openai.com.
# OPENAI_BASE_URL="https://openrouter.ai/api/v1"
# E2e local sem chave/cota: ANALYZER_PROVIDER=mock (nunca em produção)
# ANALYZER_PROVIDER="mock"
LOG_LEVEL="info"
