    "@types/node": "^20.12.12",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
