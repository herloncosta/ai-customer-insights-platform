{
  "name": "@insights/db",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src && prettier --check src --ignore-path ../.prettierignore",
    "format": "prettier --write src --ignore-path ../.prettierignore",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "prisma": "^7.10.0",
    "typescript": "^5.5.4",
    "tsx": "^4.16.2"
  }
}
