# === Raiz / Compose ===
NODE_ENV=development
LOG_LEVEL=info

# MySQL 8.0
MYSQL_ROOT_PASSWORD=rootpass123
MYSQL_DATABASE=insights_db
MYSQL_USER=insights_user
MYSQL_PASSWORD=insightspass123
MYSQL_PORT=3306

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Filas (RF-02 / RF-04)
FEEDBACK_QUEUE=feedback_processing_queue
FEEDBACK_DLQ=feedback_processing_queue.dlq

# Backend REST
BACKEND_PORT=3001
CORS_ORIGIN=http://localhost:5173

# Worker IA (RF-03) — NUNCA commitar chave real. Copie para .env local.
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-4o-mini
# Gateway compatível com a API OpenAI (ex. OpenRouter). Vazio = api.openai.com.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Frontend (build-arg -> VITE_API_URL)
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3001/api/v1
